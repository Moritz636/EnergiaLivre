# Deployer (use uma conta separada com fundos em MATIC para gas)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# RPC endpoints
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=https://polygon-rpc.com

# Polygonscan API key (https://polygonscan.com/apis)
POLYGONSCAN_API_KEY=

# Opcional: report gas usage
REPORT_GAS=false

# Parâmetros do deploy KWATT
KWATT_NAME=KWATT
KWATT_SYMBOL=KWATT
KWATT_INITIAL_SUPPLY=1000000000
KWATT_INITIAL_OWNER=0xYOUR_MULTISIG_ADDRESS
KWATT_MINTER_ROLE_HOLDER=0xYOUR_PLATFORM_WALLET
